        "def mask_ip(ip):\n",
        "    parts = str(ip).split('.')\n",
        "    if len(parts) == 4:\n",
        "        return f'{parts[0]}.{parts[1]}.xxx.xxx'\n",
        "    return '<MASKED_IP>'\n",
        "\n",
        "def mask_account(account_id):\n",
        "    text = str(account_id)\n",
        "    return text[:4] + '***' + text[-2:]\n",
        "\n",
        "samples['masked_ip'] = samples['ip_address'].apply(mask_ip)\n",
        "samples['masked_account'] = samples['account_id'].apply(mask_account)\n",
