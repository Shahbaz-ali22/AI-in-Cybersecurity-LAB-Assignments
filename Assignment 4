        "```markdown\n",
        "# Lab 4: Explainable and Privacy-Aware AI Threat Alert Lab\n",
        "This notebook demonstrates baseline predictions, interpretability via feature importances, controlled sensitivity testing, privacy masking, and responsible incident alert generation.\n",
        "```"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "562b9cdf",
        "outputId": "b8a39106-43ed-4857-885b-4893fff4ee53"
      },
      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.tree import DecisionTreeClassifier\n",
        "\n",
        "# Define features used by the model\n",
        "features = ['failed_logins', 'login_hour', 'new_device', 'download_mb']\n",
        "\n",
        "# Train a small synthetic Decision Tree to act as the baseline login-activity model\n",
        "# This represents the trained model from Lab 2\n",
        "X_train = pd.DataFrame([\n",
        "    {'failed_logins': 0, 'login_hour': 10, 'new_device': 0, 'download_mb': 40, 'label': 'Normal'},\n",
        "    {'failed_logins': 7, 'login_hour': 2, 'new_device': 1, 'download_mb': 150, 'label': 'Suspicious'},\n",
        "    {'failed_logins': 1, 'login_hour': 15, 'new_device': 0, 'download_mb': 720, 'label': 'Normal'},\n",
        "    {'failed_logins': 4, 'login_hour': 23, 'new_device': 1, 'download_mb': 400, 'label': 'Suspicious'},\n",
        "    {'failed_logins': 2, 'login_hour': 9, 'new_device': 0, 'download_mb': 80, 'label': 'Normal'},\n",
        "    {'failed_logins': 0, 'login_hour': 12, 'new_device': 0, 'download_mb': 20, 'label': 'Normal'},\n",
        "    {'failed_logins': 6, 'login_hour': 1, 'new_device': 1, 'download_mb': 300, 'label': 'Suspicious'}\n",
        "])\n",
        "\n",
        "model = DecisionTreeClassifier(random_state=42)\n",
        "model.fit(X_train[features], X_train['label'])\n",
        "print(\"Model trained and ready!\")"
      ],
      "execution_count": 2,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Model trained and ready!\n"
          ]
        }
      ]
    },
